{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureServiceBus": {
    "ConnectionString": "",
    "OrderPurchasedFailedQueue": "",
    "OrderPurchasedSucceededQueue": "",
    "GameCreatedIntegrationQueue": "",
    "GameReactiveIntegrationQueue": "",
    "GameDeactiveIntegrationQueue": "",
    "RegisterUserIntegrationQueue": ""
  },
  "DatabaseSettings": {
    "Host": "",
    "Port": "1433",
    "Username": "",
    "Password": "",
    "DatabaseName": ""
  },
  "RedisSettings": {
    "Host": "localhost",
    "Port": "6379",
    "Password": "",
    "InstanceName": ""
  },
  "JwtSettings": {
    "Secret": "",
    "ExpirationHours": 2,
    "Issuer": "",
    "Audience": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "Enrich": [ "FromLogContext" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "OrderAPI"
    }
  }
}
